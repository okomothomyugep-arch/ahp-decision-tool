# ============================================
# AHP Decision Tool - Main .gitignore
# Pour structure monorepo (backend + frontend)
# ============================================

# -------------------------------
# IDEs et éditeurs
# -------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.settings/
*.iml
.factorypath

# -------------------------------
# Fichiers systèmes et OS
# -------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# -------------------------------
# BACKEND - Java / Spring Boot
# -------------------------------

# Compiled class files
*/target/
*/**/target/
*.class

# Log files
*.log
*.log.gz
logs/
*/logs/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
*/pom.xml.tag
*/pom.xml.releaseBackup
*/pom.xml.versionsBackup
*/pom.xml.next
*/release.properties
*/dependency-reduced-pom.xml
*/buildNumber.properties
*/.mvn/timing.properties
*/.mvn/wrapper/maven-wrapper.jar

# Gradle
*/.gradle/
*/build/
*/gradle/
*/gradlew
*/gradlew.bat

# Spring Boot
*/spring-boot-starter-parent/
*/application-local.properties
*/application-dev.properties
*/bootstrap-local.yml

# -------------------------------
# FRONTEND - React / Node.js
# -------------------------------

# Node modules
*/node_modules/
*/**/node_modules/

# Build outputs
*/build/
*/dist/
*/**/build/
*/**/dist/

# Environment variables
*/.env
*/.env.local
*/.env.development.local
*/.env.test.local
*/.env.production.local
*/.env.staging

# NPM/Yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Package manager caches
*/.pnpm-store/
*/.npm/
*/.yarn/

# TypeScript
*.tsbuildinfo

# React
*/service-worker.js
*/sw.js
*/asset-manifest.json
*/precache-manifest.*

# Next.js (si vous migrez un jour)
*/.next/
*/out/

# Gatsby (si vous migrez un jour)
*/public/
*/cache/

# -------------------------------
# DOCKER
# -------------------------------
*.pid
docker-compose.override.yml
docker-compose.*.yml
!.docker/docker-compose.*.yml

# Docker volumes
/.docker/
/volumes/

# -------------------------------
# COUVERTURE DE CODE ET TESTS
# -------------------------------
*.coverprofile
*.cov
*.lcov
coverage/
.nyc_output/
*.test
*.test.js
*.spec.js

# Backend tests coverage
*/target/surefire-reports/
*/target/failsafe-reports/
*/test-output/
*/jacoco.exec

# Frontend tests coverage
*/coverage/
*/**/__snapshots__/

